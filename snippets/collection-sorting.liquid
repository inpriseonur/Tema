{%- assign sort_by = results.sort_by | default: results.default_sort_by -%}
<div class="shop-top-bar collection-toolbar">
  <div class="product-filter{% if section.settings.sidebar_handle == 'without_sidebar' %} without-sidebar{% endif %}">
    <button class="filter-button collection-toolbar__filter" type="button" data-collection-filter-open aria-controls="CollectionFilterPanel-{{ section.id }}" aria-expanded="false">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/><circle cx="9" cy="6" r="2" fill="white"/><circle cx="15" cy="12" r="2" fill="white"/><circle cx="9" cy="18" r="2" fill="white"/></svg>
      <span>{{ 'collections.facets.filter_button' | t }}</span>
      <span class="collection-toolbar__badge" data-collection-filter-count hidden></span>
    </button>
  </div>
  {% if section.blocks.size > 0 %}
    <nav class="collection-quick-links" aria-label="{{ 'collections.facets.quick_links' | t }}" data-collection-quick-links>
      {% for block in section.blocks %}
        {% if block.type == 'quick_link' and block.settings.title != blank and block.settings.url != blank %}
          <a class="collection-quick-link" href="{{ block.settings.url | escape }}" data-collection-quick-link {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</a>
        {% endif %}
      {% endfor %}
    </nav>
  {% endif %}
  {% if section.settings.short_by_enable %}
    <details class="collection-sort" data-collection-sort>
      <summary>{{ 'collections.sorting.title' | t }} <span aria-hidden="true">⌄</span></summary>
      <ul role="list">
        {% for option in results.sort_options %}
          <li><a href="{{ results.url }}?sort_by={{ option.value | url_encode }}" data-collection-sort-value="{{ option.value | escape }}"{% if option.value == sort_by %} aria-current="true"{% endif %}>{{ option.name | escape }}</a></li>
        {% endfor %}
      </ul>
    </details>
  {% endif %}
</div>
<p class="collection-toolbar-error" data-collection-toolbar-error role="alert" hidden>{{ 'collections.facets.request_error' | t }}</p>
