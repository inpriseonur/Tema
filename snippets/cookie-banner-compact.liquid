{%- comment -%}
  Shopify'ın yerleşik çerez onay banner'ını (#shopify-pc__banner) mobilde küçültür.
  Banner metni ve butonları Shopify admin > Ayarlar > Müşteri gizliliği'nden gelir;
  burada yalnızca görünüm değişir. "Kabul Et" ve "Reddet" eşit ağırlıkta kalır (KVKK).
{%- endcomment -%}
<style>
  @media (max-width: 767px) {
    #shopify-pc__banner {
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom)) !important;
      max-height: 45vh;
      border-radius: 12px 12px 0 0;
    }
    #shopify-pc__banner .shopify-pc__banner__body {
      margin: 0 0 10px;
    }
    /* Başlık ekran okuyucular için kalır, görsel olarak gizlenir */
    #shopify-pc__banner #shopify-pc__banner__body-title {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
    #shopify-pc__banner .shopify-pc__banner__body p {
      font-size: 12px;
      line-height: 1.4;
    }
    #shopify-pc__banner .shopify-pc__banner__btns {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px;
    }
    #shopify-pc__banner .shopify-pc__banner__btns button {
      flex: 1 1 0;
      margin: 0;
      min-height: 44px;
      padding: 8px 12px;
      font-size: 14px;
    }
    #shopify-pc__banner #shopify-pc__banner__btn-accept { order: 1; }
    #shopify-pc__banner #shopify-pc__banner__btn-decline { order: 2; }
    #shopify-pc__banner #shopify-pc__banner__btn-manage-prefs {
      order: 3;
      flex: 1 1 100%;
      min-height: 32px;
      padding: 4px;
      font-size: 12px;
    }

    /* Altta sabit bir çubuk varsa (ürün satın alma çubuğu veya alt menü) banner onun üstünde durur */
    #shopify-pc__banner {
      bottom: var(--pg-bottom-bar-offset, 0px) !important;
    }
    html[data-pg-bottom-bar] #shopify-pc__banner {
      padding-bottom: 12px !important;
    }
  }
</style>
<script>
  (function () {
    var BAR_SELECTOR = '.mobile-purchase-bar, .mobile-sticky-menu';
    var media = window.matchMedia('(max-width: 767px)');
    var root = document.documentElement;
    var observed = typeof WeakSet === 'function' ? new WeakSet() : null;
    var resizeObserver = typeof ResizeObserver === 'function' ? new ResizeObserver(update) : null;

    function visibleTop(el) {
      var style = window.getComputedStyle(el);
      if (style.position !== 'fixed' || style.display === 'none' || style.visibility === 'hidden') return null;
      var rect = el.getBoundingClientRect();
      if (rect.height === 0 || rect.bottom < window.innerHeight - 2) return null;
      var top = rect.top;
      // Çubuğun üstüne taşan parçalar: satın alma çubuğundaki geri sayım şeridi, alt menüdeki yuvarlak sepet butonu
      var overhangs = el.querySelectorAll('.mobile-sticky-countdown, .cart-icon-wrapper');
      for (var i = 0; i < overhangs.length; i++) {
        var r = overhangs[i].getBoundingClientRect();
        if (r.height > 0) top = Math.min(top, r.top);
      }
      return top;
    }

    function update() {
      var offset = 0;
      if (media.matches) {
        var bars = document.querySelectorAll(BAR_SELECTOR);
        for (var i = 0; i < bars.length; i++) {
          if (resizeObserver && observed && !observed.has(bars[i])) {
            observed.add(bars[i]);
            resizeObserver.observe(bars[i]);
          }
          var top = visibleTop(bars[i]);
          if (top !== null) offset = Math.max(offset, Math.round(window.innerHeight - top));
        }
      }
      if (offset > 0) {
        root.style.setProperty('--pg-bottom-bar-offset', offset + 'px');
        root.setAttribute('data-pg-bottom-bar', '');
      } else {
        root.style.removeProperty('--pg-bottom-bar-offset');
        root.removeAttribute('data-pg-bottom-bar');
      }
    }

    document.addEventListener('DOMContentLoaded', update);
    window.addEventListener('load', function () {
      update();
      // Satın alma çubuğu tema JS'i tarafından sonradan oluşturulabiliyor
      setTimeout(update, 600);
      setTimeout(update, 2000);
    });
    window.addEventListener('resize', update);
    if (media.addEventListener) media.addEventListener('change', update);
  })();
</script>
