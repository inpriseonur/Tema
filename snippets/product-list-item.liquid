{%- liquid

  assign ratio = 1
  if product.featured_media and settings.image_ratio == 'portrait'
  assign ratio = 0.8
  elsif product.featured_media and settings.image_ratio == 'adapt'
  assign ratio = product.featured_media.aspect_ratio
  endif
  if ratio == 0 or ratio == null
  assign ratio = 1
  endif
  assign ga4_variant = product.selected_or_first_available_variant
  assign ga4_list_id_value = ga4_list_id | default: 'product_list'
  assign ga4_list_name_value = ga4_list_name | default: 'Product list'
  assign ga4_click_area_value = ga4_click_area | default: ga4_list_name_value
  assign ga4_source_page_type_value = ga4_source_page_type | default: template.name
  assign ga4_source_page_name_value = ga4_source_page_name | default: page_title
  assign ga4_index_value = ga4_index | default: forloop.index
  assign ga4_item_category_value = ga4_item_category | default: collection.title
-%}
<div class="single-product-wrap">
  <div class="product-image">
    <a
      class="pro-img ratio"
      href="{{ product.url | within: collection }}"
      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
      data-ga4-product-click
      data-ga4-item-id="{{ product.id }}"
      data-ga4-item-name="{{ product.title | escape }}"
      data-ga4-item-variant="{% unless ga4_variant.title == 'Default Title' %}{{ ga4_variant.title | escape }}{% endunless %}"
      data-ga4-item-brand="{{ product.vendor | escape }}"
      data-ga4-item-category="{{ ga4_item_category_value | escape }}"
      data-ga4-price="{{ ga4_variant.price }}"
      data-ga4-currency="{{ cart.currency.iso_code }}"
      data-ga4-index="{{ ga4_index_value }}"
      data-ga4-list-id="{{ ga4_list_id_value | escape }}"
      data-ga4-list-name="{{ ga4_list_name_value | escape }}"
      data-ga4-click-area="{{ ga4_click_area_value | escape }}"
      data-ga4-source-page-type="{{ ga4_source_page_type_value | escape }}"
      data-ga4-source-page-name="{{ ga4_source_page_name_value | escape }}"
    >
      {%- if product.featured_media -%}
        <div class="{%- if product.media[1] != blank -%} img1{%- endif -%}">
          {% assign image_height = product.featured_media.width | divided_by: product.featured_media.aspect_ratio %}
          {{
            product.featured_media
            | image_url: width: 720
            | image_tag: width: product.featured_media.width, height: image_height, class: 'lazyload', loading: 'lazy'
          }}
        </div>
        {%- if settings.enable_hover_product and product.media[1] != blank -%}
          <div class="img2">
            {% assign image_height = product.media[1].width | divided_by: product.media[1].aspect_ratio %}
            {{
              product.media[1]
              | image_url: width: 720
              | image_tag: width: product.media[1].width, height: image_height, class: 'lazyload', loading: 'lazy'
            }}
          </div>
        {%- endif -%}
      {%- else -%}
        {%- capture placeholder -%}product-apparel-{% cycle 1, 2, 3 %}{%- endcapture -%}
        {{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>

  </div>
  <div class="product-content">
    <div class="product-title">
      <a
        href="{{ product.url | within: collection }}"
        title="{{ product.title }}"
        data-ga4-product-click
        data-ga4-item-id="{{ product.id }}"
        data-ga4-item-name="{{ product.title | escape }}"
        data-ga4-item-variant="{% unless ga4_variant.title == 'Default Title' %}{{ ga4_variant.title | escape }}{% endunless %}"
        data-ga4-item-brand="{{ product.vendor | escape }}"
        data-ga4-item-category="{{ ga4_item_category_value | escape }}"
        data-ga4-price="{{ ga4_variant.price }}"
        data-ga4-currency="{{ cart.currency.iso_code }}"
        data-ga4-index="{{ ga4_index_value }}"
        data-ga4-list-id="{{ ga4_list_id_value | escape }}"
        data-ga4-list-name="{{ ga4_list_name_value | escape }}"
        data-ga4-click-area="{{ ga4_click_area_value | escape }}"
        data-ga4-source-page-type="{{ ga4_source_page_type_value | escape }}"
        data-ga4-source-page-name="{{ ga4_source_page_name_value | escape }}"
      >
        {%- if show_full_title -%}
          {{ product.title }}
        {%- else -%}
          {{ product.title | truncate: 30 }}
        {%- endif -%}
      </a>
    </div>
    <div class="price-box">
      <span class="new-price">{{ product.variants.first.price | money }}</span>
      {% if product.variants.first.compare_at_price > product.variants.first.price %}
      <span class="old-price">{{ product.variants.first.compare_at_price | money }}</span>

      {% endif %}
    </div>
    {% render 'product-card-volume-teaser', product: product, mode: 'compact' %}
    {%- if settings.show_rating -%}
    <div class="product-grid-rating">
      {% if product.metafields.judgeme.badge %}
      <div class='jdgm-widget jdgm-preview-badge'>
        {{ product.metafields.judgeme.badge }}
      </div>
      {% else %}
      <div class="jdgm-prev-badge jdgm--js" data-average-rating="0.00" data-number-of-reviews="0">
        <span class="jdgm-prev-badge__stars" data-score="0.00"><span class="jdgm-star jdgm--off"></span><span class="jdgm-star jdgm--off"></span><span class="jdgm-star jdgm--off"></span><span class="jdgm-star jdgm--off"></span><span class="jdgm-star jdgm--off"></span></span>
        <span class="jdgm-prev-badge__text">No reviews</span>
      </div>
      {% endif %}
    </div>
    {%- endif -%}
  </div>
</div>
