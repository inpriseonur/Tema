<section class="related-product">
  <div class="container">
    <div class="row">
      <div class="col">
        <div class="product-related">
          <div class="section-title">
            {% if section.settings.related_title !='' %}
            <h2 class="heading-home">{{ section.settings.related_title }}</h2>
            {% endif %}
          </div>
          <relative-pro class="related-slider isolate" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}">
            {% if recommendations.performed and recommendations.products_count > 0 %}
            <div class="product-related-slider swiper" id="related-slider" data-slides-per-view="{{ section.settings.product_view }}"slide-view="5">
              <div class="swiper-wrapper">
                {% for recommendation in recommendations.products %}
                <div class="swiper-slide">
                  {% render 'product-grid-item',
                    product: recommendation,
                    section_id: section.id,
                    ga4_list_id: 'product_related',
                    ga4_list_name: section.settings.related_title,
                    ga4_click_area: 'Ürün detay - ilgili ürünler',
                    ga4_source_page_type: 'product',
                    ga4_source_page_name: product.title,
                    ga4_index: forloop.index
                  %}
                </div>
                {% endfor %}
              </div>
            </div>
            <div class="related-product-buttons">
              <button type="button" class="related-product-button related-product-button-prev" aria-label="Önceki ürün"></button>
              <button type="button" class="related-product-button related-product-button-next" aria-label="Sonraki ürün"></button>
            </div>
            {% elsif recommendations.performed != true %}
            <div class="related-loading" aria-hidden="true">
              {% for placeholder in (1..3) %}
              <div class="related-loading__card single-product-wrap">
                <div class="product-image"><div class="ratio related-loading__image"></div></div>
                <div class="product-content">
                  <div class="related-loading__title"><span></span><span></span></div>
                  <div class="related-loading__price"></div>
                  <div class="related-loading__detail"></div>
                </div>
              </div>
              {% endfor %}
            </div>
            {% endif %}
          </relative-pro>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Related Product",
  "settings": [
  {
      "type": "header",
      "content": "Section Padding"
  },
  {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 80
  },
  {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 80
  },
  {
      "type" : "paragraph",
      "content" : "Mobile"
  },
  {
      "type": "range",
      "id": "section_padding_top_xs",
      "label": "Section Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
  },
  {
      "type": "range",
      "id": "section_padding_bottom_xs",
      "label": "Section Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
  },
  {
    "type": "text",
    "id": "related_title",
    "label": "Section Title",
    "default": "Related Product"
  },
  {
    "type": "header",
    "content": "Product Options"
  },
  {
    "type": "text",
    "id": "products_to_show",
    "label": "Product Limit",
    "default": "8"
  }
  ]
}
{% endschema %}
<style>
  .related-product {
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
  }

  .related-product .section-title h2 {
    text-transform: none;
  }

  .related-product .single-product-wrap .product-content {
    text-align: left;
  }

  .related-product .single-product-wrap .product-content .product-title a {
    display: -webkit-box;
    height: 39px;
    overflow: hidden;
    color: #061f4f;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.38;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .related-product .single-product-wrap .product-content .price-box {
    margin-top: 7px;
    line-height: 1.1;
  }

  .related-product .single-product-wrap .price-box .new-price {
    color: var(--color-secondary);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.1;
  }

  .related-product .single-product-wrap .price-box .old-price {
    color: #8f8f8f;
    font-size: 13px;
    line-height: 1.1;
  }

  .related-product .single-product-wrap .product-image .product-label .sale-title {
    min-width: 40px;
    padding: 4px 9px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
  }

  .related-product .product-related {
    position: relative;
  }

  .related-product .related-slider {
    display: block;
    position: relative;
  }

  .related-product .related-loading {
    display: none;
  }

  .related-product .related-product-button {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(6, 31, 79, 0.16);
    border-radius: 4px;
    color: var(--color-primary);
    background-color: rgba(255, 255, 255, 0.92);
    box-shadow: 0 4px 12px rgba(6, 31, 79, 0.08);
    transform: translateY(-50%);
    transition: all 0.2s ease-in-out;
  }

  .related-product .related-product-button:hover {
    color: #fff;
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    box-shadow: 0 6px 16px rgba(6, 31, 79, 0.12);
  }

  .related-product .related-product-button.swiper-button-disabled {
    opacity: 0.35;
    pointer-events: none;
  }

  .related-product .related-product-button-prev {
    left: -15px;
  }

  .related-product .related-product-button-next {
    right: -15px;
  }

  .related-product .related-product-button:after {
    font: normal normal normal 18px/1 FontAwesome;
  }

  .related-product .related-product-button-prev:after {
    content: "\f104";
  }

  .related-product .related-product-button-next:after {
    content: "\f105";
  }

  @media (min-width: 1200px) {
    .related-product .section-title h2 {
      font-size: 24px;
      margin-bottom: 22px;
    }

    .related-product .single-product-wrap .product-image {
      width: 80%;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media(max-width: 1199px){
    .related-product {
      padding-top: {{ section.settings.section_padding_top_xs }}px;
      padding-bottom: {{ section.settings.section_padding_bottom_xs }}px;
    }
  }

  @media(max-width: 767px){
    #shopify-section-{{ section.id }} .section-title h2 {
      font-size: 16px;
      line-height: 1.3;
      margin-bottom: 14px;
    }

    #shopify-section-{{ section.id }} .related-product {
      position: relative;
    }

    /* The top divider uses existing spacing; the bottom divider follows the cards. */
    #shopify-section-{{ section.id }} .related-product::before,
    #shopify-section-{{ section.id }} .related-product::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      height: 5px;
      background: #f4f5f7;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .related-product::before {
      top: 0;
    }

    #shopify-section-{{ section.id }} .related-product::after {
      position: static;
      display: block;
      margin-top: 12px;
    }

    #shopify-section-{{ section.id }} .related-loading {
      display: flex;
      gap: 10px;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .related-loading__card {
      flex: 0 0 calc((100% - 36px) / 2);
    }

    #shopify-section-{{ section.id }} .related-loading__image {
      --ratio-percent: min(90%, calc(82% + 12px));
      border-radius: 4px;
    }

    #shopify-section-{{ section.id }} .related-loading__title {
      height: 32px;
      padding-top: 2px;
    }

    #shopify-section-{{ section.id }} .related-loading__title span {
      display: block;
      height: 10px;
      margin-bottom: 6px;
      width: 90%;
    }

    #shopify-section-{{ section.id }} .related-loading__title span:last-child {
      width: 65%;
    }

    #shopify-section-{{ section.id }} .related-loading__price {
      width: 70%;
      height: 18px;
      margin-top: 4px;
    }

    #shopify-section-{{ section.id }} .related-loading__detail {
      width: 80%;
      height: 28px;
      margin-top: 4px;
    }

    #shopify-section-{{ section.id }} .related-loading__image,
    #shopify-section-{{ section.id }} .related-loading__title span,
    #shopify-section-{{ section.id }} .related-loading__price,
    #shopify-section-{{ section.id }} .related-loading__detail {
      border-radius: 4px;
      background: linear-gradient(100deg, #f1f2f4 20%, #fafafa 45%, #f1f2f4 70%);
      background-size: 240% 100%;
      animation: related-product-shimmer 1.8s ease-in-out infinite;
    }

    /* Match the homepage: two cards and a small preview of the next one. */
    #shopify-section-{{ section.id }} .product-related-slider .swiper-wrapper {
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .product-related-slider .swiper-slide {
      width: calc((100% - 36px) / 2);
      height: auto;
      display: flex;
    }

    #shopify-section-{{ section.id }} .product-related-slider:not(.swiper-initialized) .swiper-slide {
      margin-right: 10px;
    }

    #shopify-section-{{ section.id }} .single-product-wrap {
      width: 100%;
      height: auto;
      display: flex;
      flex-direction: column;
      padding: 5px 4px;
      border: 1px solid rgba(6, 31, 79, 0.06);
      border-radius: 6px;
    }

    #shopify-section-{{ section.id }} .single-product-wrap .product-image {
      width: 100%;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .single-product-wrap .product-image .ratio {
      --ratio-percent: min(90%, calc(82% + 12px)) !important;
    }

    #shopify-section-{{ section.id }} .single-product-wrap .product-image .ratio img {
      object-fit: contain;
    }

    #shopify-section-{{ section.id }} .single-product-wrap .product-content {
      margin-top: 4px;
    }

    .related-product .single-product-wrap .product-content .product-title a {
      height: 32px;
      font-size: 12px;
      font-weight: 500;
      line-height: 1.3;
    }

    #shopify-section-{{ section.id }} .single-product-wrap .price-box .new-price {
      font-size: 16px !important;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .product-content .price-box,
    #shopify-section-{{ section.id }} .product-content .product-volume-teaser {
      margin-top: 4px;
    }

    #shopify-section-{{ section.id }} .product-volume-teaser,
    #shopify-section-{{ section.id }} .product-volume-teaser__value {
      font-size: 11px;
      font-weight: 600;
      color: #596273;
    }

    #shopify-section-{{ section.id }} .product-volume-teaser__amount {
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .single-product-wrap .price-box .old-price {
      display: block;
      margin-top: 3px;
      padding-left: 0;
      font-size: 12px !important;
      white-space: nowrap;
    }

    .related-product .single-product-wrap .product-image .product-label .sale-title {
      min-width: 36px;
      padding: 3px 8px;
      font-size: 11px;
    }

    #shopify-section-{{ section.id }} .related-product-buttons {
      display: none;
    }
  }

  @keyframes related-product-shimmer {
    from { background-position: 100% 0; }
    to { background-position: -100% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .related-loading * {
      animation: none;
    }
  }
</style>



