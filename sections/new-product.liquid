<style>
.new-product {
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
}
#shopify-section-{{ section.id }} .new-product__heading {
    margin: 0 0 8px;
    color: var(--color-primary);
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
    text-align: left;
    overflow-wrap: anywhere;
}
@media (min-width: 1199px) {
    #shopify-section-{{ section.id }} .new-product__heading {
        font-size: 15px;
        line-height: 17px;
    }
}
@media (max-width: 767px) {
    #shopify-section-{{ section.id }} .new-product__heading { font-size: 11.5px; }
}
@media(max-width: 1199px) {
    .new-product {
        padding-top: {{ section.settings.section_padding_top_xs }}px;
        padding-bottom: {{ section.settings.section_padding_bottom_xs }}px;
    }
}

.new-product .new-product-slider .owl-nav{
    margin-top: 0;
}
#shopify-section-{{ section.id }} .new-product-slider .owl-stage {
    display: flex;
    align-items: stretch;
}
#shopify-section-{{ section.id }} .new-product-slider .owl-item {
    display: flex;
    float: none;
}
#shopify-section-{{ section.id }} .new-product-slider .item {
    display: flex;
    width: 100%;
}
#shopify-section-{{ section.id }} .new-product-slider .item > .single-product-wrap {
    width: 100%;
    height: auto;
}
.new-product .new-product-slider .single-product-wrap {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid rgba(6, 31, 79, 0.06);
    border-radius: 6px;
    padding: 10px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}
.new-product .new-product-slider .single-product-wrap .product-image {
    width: 100%;
    overflow: hidden;
}
.new-product .new-product-slider .single-product-wrap .product-image .ratio {
    --ratio-percent: 88% !important;
}
.new-product .new-product-slider .single-product-wrap .product-image .ratio img {
    object-fit: contain;
    transition: transform 0.2s ease;
}
.new-product .new-product-slider .single-product-wrap .product-content {
    margin-top: 12px;
    text-align: left;
}
.new-product .new-product-slider .single-product-wrap .product-content .product-title a {
    display: -webkit-box;
    height: 39px;
    overflow: hidden;
    color: #061f4f;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.38;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}
.new-product .new-product-slider .single-product-wrap .product-content .price-box {
    margin-top: 7px;
    line-height: 1.1;
}
.new-product .new-product-slider .single-product-wrap .price-box .new-price {
    color: var(--color-secondary);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.1;
}
.new-product .new-product-slider .single-product-wrap .price-box .old-price {
    color: #8f8f8f;
    font-size: 13px;
    line-height: 1.1;
}
.new-product .new-product-slider .single-product-wrap .product-image .product-label .sale-title {
    min-width: 40px;
    padding: 4px 9px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
}
@media (hover: hover) and (min-width: 992px) {
    .new-product .new-product-slider .single-product-wrap:hover {
        border-color: rgba(6, 31, 79, 0.16);
        box-shadow: 0 8px 22px rgba(6, 31, 79, 0.08);
        transform: translateY(-2px);
    }
    .new-product .new-product-slider .single-product-wrap:hover .product-image .ratio img {
        transform: scale(1.02);
    }
    .new-product .new-product-slider .single-product-wrap:hover .product-content .product-title a {
        color: var(--color-primary);
    }
}
.new-product .new-product-slider .owl-nav button{
    position: absolute;
    bottom: 50%;
    transform: translateY(50%);
    margin: 0;
    line-height: 0;
    font-size: 18px;
    height: 28px;
    width: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(6, 31, 79, 0.16);
    border-radius: 4px;
    color: var(--color-primary);
    background-color: rgba(255, 255, 255, 0.92);
    box-shadow: 0px 4px 12px rgba(6, 31, 79, 0.08);
    -webkit-transition: all 0.2s ease-in-out 0s;
    -o-transition: all 0.2s ease-in-out 0s;
    transition: all 0.2s ease-in-out 0s;
}
.new-product .new-product-slider .owl-nav button:hover {
    color: #fff;
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    box-shadow: 0px 6px 16px rgba(6, 31, 79, 0.12);
}
.new-product .new-product-slider .owl-nav button.owl-prev{
    left: -15px;
}
.new-product .new-product-slider .owl-nav button.owl-next{
    right: -15px;
}
@media(max-width: 767px) {
    .new-product .new-product-slider .single-product-wrap .product-image .ratio {
        --ratio-percent: 82% !important;
    }
    .new-product .new-product-slider .single-product-wrap .product-content {
        margin-top: 6px;
    }
    .new-product .new-product-slider .single-product-wrap .product-content .product-title a {
        height: 32px;
        font-size: 12px;
        font-weight: 500;
        line-height: 1.3;
    }
    .new-product .new-product-slider .single-product-wrap .price-box .new-price {
        font-size: 16px !important;
        white-space: nowrap;
    }
    #shopify-section-{{ section.id }} .new-product-slider .product-content .price-box,
    #shopify-section-{{ section.id }} .new-product-slider .product-content .product-volume-teaser {
        margin-top: 4px;
    }
    #shopify-section-{{ section.id }} .new-product-slider .product-volume-teaser,
    #shopify-section-{{ section.id }} .new-product-slider .product-volume-teaser__value {
        font-size: 11px;
        font-weight: 600;
        color: #596273;
    }
    #shopify-section-{{ section.id }} .new-product-slider .product-volume-teaser__amount {
        white-space: nowrap;
    }
    .new-product .new-product-slider .single-product-wrap .price-box .old-price {
        display: block;
        margin-top: 3px;
        padding-left: 0;
        font-size: 12px !important;
        white-space: nowrap;
    }
    .new-product .new-product-slider .single-product-wrap .product-image .product-label .sale-title {
        min-width: 36px;
        padding: 3px 8px;
        font-size: 11px;
    }
    .new-product .new-product-slider .owl-nav button {
        height: 26px;
        width: 26px;
        font-size: 16px;
    }
    .new-product .new-product-slider .owl-nav button.owl-prev {
        left: -10px;
    }
    .new-product .new-product-slider .owl-nav button.owl-next {
        right: -10px;
    }
}

/* Reserve the product row before Owl initializes, using its responsive widths. */
#shopify-section-{{ section.id }} .new-product-slider:not(.owl-loaded):not(.owl-loading) {
    --initial-columns: 1;
    --initial-gap: 12px;
    display: flex;
    align-items: stretch;
    gap: var(--initial-gap);
    overflow: hidden;
}
#shopify-section-{{ section.id }} .new-product-slider:not(.owl-loaded):not(.owl-loading) > .item {
    flex: 0 0 calc((100% - (var(--initial-columns) - 1) * var(--initial-gap)) / var(--initial-columns));
    min-width: 0;
}
@media (min-width: 320px) {
    #shopify-section-{{ section.id }} .new-product-slider:not(.owl-loaded):not(.owl-loading) {
        --initial-columns: 2;
    }
}
@media (min-width: 768px) {
    #shopify-section-{{ section.id }} .new-product-slider:not(.owl-loaded):not(.owl-loading) {
        --initial-gap: 30px;
    }
}
@media (min-width: 979px) {
    #shopify-section-{{ section.id }} .new-product-slider:not(.owl-loaded):not(.owl-loading) {
        --initial-columns: 3;
    }
}
@media (min-width: 1199px) {
    #shopify-section-{{ section.id }} .new-product-slider,
    #shopify-section-{{ section.id }} .new-product-slider:not(.owl-loaded):not(.owl-loading) {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        grid-auto-rows: 1fr;
        gap: 12px;
        align-items: stretch;
        overflow: visible;
    }
    #shopify-section-{{ section.id }} .new-product-slider > .item {
        min-width: 0;
    }
    #shopify-section-{{ section.id }} .new-product-slider .product-content .product-title a {
        font-size: 13px;
    }
    #shopify-section-{{ section.id }} .new-product-slider .price-box .new-price,
    #shopify-section-{{ section.id }} .new-product-slider .price-box .old-price,
    #shopify-section-{{ section.id }} .new-product-slider .product-volume-teaser__amount {
        white-space: nowrap;
    }
}
@media (min-width: 1400px) {
    #shopify-section-{{ section.id }} .new-product-slider,
    #shopify-section-{{ section.id }} .new-product-slider:not(.owl-loaded):not(.owl-loading) {
        grid-template-columns: repeat(5, minmax(0, 1fr));
    }
}
</style>
<section class="new-product">
  <div class="container">
    <div class="row">
      <div class="col-xl-12 col-lg-12 col-md-12">
        {%- assign list_heading = section.settings.section_title | strip -%}
        {%- if list_heading != blank -%}
          <h2 class="new-product__heading">{{ list_heading | escape }}</h2>
        {%- endif -%}
        {% assign category_product = collections[section.settings.label_product] %}
        <div class="new-product-slider owl-carousel" id="new-pro-{{ section.id }}">
          {% assign category_product_limit = section.settings.category_product_limit_handle %}
          {% for product in category_product.products limit: category_product_limit %}
          <div class="item">
            {% render 'product-grid-item',
              product: product,
              section_id: section.id,
              ga4_list_id: 'home_new_product',
              ga4_list_name: section.settings.section_title,
              ga4_click_area: section.settings.section_title,
              ga4_source_page_type: 'home',
              ga4_source_page_name: 'Ana sayfa',
              ga4_item_category: category_product.title,
              ga4_index: forloop.index
            %}
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
<script type="text/javascript">
(() => {
  const element = document.getElementById('new-pro-{{ section.id }}');
  if (!element) return;
  const desktop = window.matchMedia('(min-width: 1199px)');
  const options = {
    rewind: true,
    margin: 30,
    items: 4,
    nav: true,
    navText: ['<i class="fa fa-angle-left"></i>','<i class="fa fa-angle-right"></i>'],
    dots: false,
    {%- if settings.enable_rtl -%}
    rtl: true,
    {%- endif -%}
    loop: {{ section.settings.loop }},
    autoplay: {{ section.settings.autoplay }},
    autoplayTimeout: {{ section.settings.autoplay_time }},
    autoplayHoverPause: true,
    responsive:{
        0:{
          items: 1,
          margin: 12
        },
        320:{
          items: 2,
          margin: 12
        },
        479:{
          items: 2,
          margin: 12
        },
        540:{
          items: 2,
           margin: 12
        },
        768:{
          items: 2
        },
        979:{
          items: 3
        }
      }
  };

  function updateLayout() {
    if (!element.isConnected || !window.jQuery || !window.jQuery.fn.owlCarousel) return;
    const slider = window.jQuery(element);
    if (desktop.matches) {
      if (slider.data('owl.carousel')) slider.trigger('destroy.owl.carousel');
    } else if (!slider.data('owl.carousel')) {
      slider.owlCarousel(options);
    }
  }

  function onSectionUnload(event) {
    if (!event.target.contains(element)) return;
    desktop.removeEventListener('change', updateLayout);
    document.removeEventListener('DOMContentLoaded', updateLayout);
    document.removeEventListener('shopify:section:unload', onSectionUnload);
    if (window.jQuery && window.jQuery(element).data('owl.carousel')) {
      window.jQuery(element).trigger('destroy.owl.carousel');
    }
  }

  desktop.addEventListener('change', updateLayout);
  document.addEventListener('shopify:section:unload', onSectionUnload);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateLayout, { once: true });
  } else {
    updateLayout();
  }
})();
</script>

{% schema %}
{
  "name": "New product",
  "settings": [
  {
      "type": "header",
      "content": "Section Padding"
  },
  {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 80
  },
  {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 80
  },
  {
      "type" : "paragraph",
      "content" : "Mobile"
  },
  {
      "type": "range",
      "id": "section_padding_top_xs",
      "label": "Section Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
  },
  {
      "type": "range",
      "id": "section_padding_bottom_xs",
      "label": "Section Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
  },
  {
    "type": "text",
    "id": "section_title",
    "label": "Section title",
    "default": "Trending products"
  },
  {
    "type": "text",
    "id": "category_product_limit_handle",
    "label": "Product Limit",
    "default": "10"
  },
  {
    "type" : "collection",
    "id" : "label_product",
    "label" : "New Product"
  },
  {
    "type": "header",
    "content": "slider settings"
  },
  {
    "type": "paragraph",
    "content": "Kaydırma ayarları mobil ve tablet içindir. Masaüstünde ürünler 12 px aralıkla grid olarak listelenir: 1199–1399 px ekranlarda 4, daha geniş ekranlarda 5 sütun."
  },
  {
    "type": "checkbox",
    "id": "loop",
    "label": "Slider loop",
    "default": true
  },
  {
    "type": "checkbox",
    "id": "autoplay",
    "label": "Slider autoplay",
    "default": true
  },
  {
    "type": "number",
    "id": "autoplay_time",
    "label": "Slider timer out",
    "default": 5000
  }
  ],
  "presets":[
  {
    "name": "New product"
  }
  ]
}
{% endschema %}
