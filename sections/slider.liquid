<style type="text/css">
  .home-mobile-brand-links {
    display: none;
  }
  @media (max-width: 767px) {
    .home-mobile-brand-links {
      position: relative;
      display: block;
      margin-bottom: -3px;
      min-width: 0;
    }
    .home-mobile-brand-links::after {
      content: '';
      position: absolute;
      left: calc(50% - 50vw);
      bottom: -6px;
      width: 100vw;
      height: 1px;
      background-color: #e7e7e7;
      pointer-events: none;
    }
    .home-mobile-brand-links__list {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      margin: 0;
      padding: 3px 0;
      list-style: none;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
    }
    .home-mobile-brand-links__list::-webkit-scrollbar {
      display: none;
    }
    .home-mobile-brand-links__list > li {
      flex: 0 0 auto;
      scroll-snap-align: start;
    }
    .home-mobile-brand-links__list a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 28px;
      padding: 4px 8px;
      border: 1px solid #e0e4eb;
      border-radius: 14px;
      background: #fff;
      color: #142850;
      font-size: 10.5px;
      font-weight: 500;
      letter-spacing: 0;
      line-height: 1.2;
      white-space: nowrap;
      text-decoration: none;
    }
    .home-mobile-brand-links__list a.home-mobile-brand-links__link--gold {
      border-color: #c9a063;
    }
    .home-mobile-brand-links__list a.home-mobile-brand-links__link--navy {
      border-color: #52678e;
    }
    .home-mobile-brand-links__list a:focus-visible {
      outline: 2px solid #142850;
      outline-offset: 1px;
    }
  }
</style>
<style type="text/css">
  .slider-content {
    margin-top: 30px;
  }
  .slider-content .grid-wrap {
    display: flex; flex-wrap: wrap; margin: -30px 0 0 -30px;
  }
  .slider-content .grid-wrap .grid-wrapper {
    width: calc(100% - 30px); margin: 30px 0 0 30px; min-width: 0;
  }
  .slider-content .secondary-hero { display: none; }
  .slider-content .home-carousel { display: block; min-width: 0; }
  .slider-content .home-slider { overflow: hidden; }
  .slider-content .home-slider .swiper-wrapper { display: flex; }
  .slider-content .home-slider .swiper-slide { flex-shrink: 0; width: 100%; }
  #shopify-section-{{ section.id }} .home-slider:not(.swiper-initialized) .swiper-wrapper {
    width: 100%; margin: 0; gap: 0;
  }
  #shopify-section-{{ section.id }} .home-slider:not(.swiper-initialized) .swiper-slide {
    width: 100%; max-width: none; padding: 0;
  }
  #shopify-section-{{ section.id }} .home-slider .slide-image > a:before {
    padding-bottom: var(--desktop-image-padding); display: block; content: '';
  }
  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .home-slider .slide-image > a:before {
      padding-bottom: var(--mobile-image-padding);
    }
  }
  @media (min-width: 1200px) {
    #shopify-section-{{ section.id }} .grid-wrap {
      display: grid; grid-template-columns: minmax(0, 1fr); gap: {{ section.settings.desktop_gap }}px;
      margin: 0;
    }
    #shopify-section-{{ section.id }} .grid-wrap.has-secondary {
      grid-template-columns: minmax(0, 1fr) minmax(0, {{ section.settings.desktop_secondary_width }}px);
    }
    #shopify-section-{{ section.id }} .grid-wrap .grid-wrapper { width: 100%; margin: 0; }
    #shopify-section-{{ section.id }} .home-slider .slide-image > a:before {
      padding-bottom: {{ 100.0 | divided_by: section.settings.desktop_primary_ratio }}%;
    }
    #shopify-section-{{ section.id }} .home-slider .slide-image > a img { object-fit: contain; }
    #shopify-section-{{ section.id }} .secondary-hero { display: block; position: relative; min-width: 0; }
    #shopify-section-{{ section.id }} .secondary-hero__link { display: block; height: 100%; }
    #shopify-section-{{ section.id }} .secondary-hero picture,
    #shopify-section-{{ section.id }} .secondary-hero img {
      position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover;
    }
    #shopify-section-{{ section.id }} .home-slider .slider-arrow button {
      color: #b8925e;
      border: 1px solid #b8925e;
      background-color: rgba(255, 255, 255, 0.94);
    }
    #shopify-section-{{ section.id }} .home-slider .slider-arrow button:hover {
      color: #fff;
      background-color: #b8925e;
    }
    #shopify-section-{{ section.id }} .home-slider .slider-arrow button.arrow-prev {
      left: 8px;
    }
    #shopify-section-{{ section.id }} .home-slider .slider-arrow button.arrow-next {
      right: 8px;
    }
  }
  @media (min-width: 1200px) and (max-width: 1399px) {
    #shopify-section-{{ section.id }} .grid-wrap.has-secondary {
      grid-template-columns: minmax(0, 1fr) minmax(0, {{ section.settings.desktop_secondary_width | minus: 40 }}px);
    }
  }
.slider-content .home-slider,
.slider-content .home-slider .owl-stage-outer,
.slider-content .home-slider .owl-stage,
.slider-content .home-slider .owl-item,
.slider-content .home-slider .item {
  height: 100%!important;
}
.slider-content .home-slider .slide-image{
  position: relative;
  height: 100%;
}
.slider-content .home-slider .slide-image > a {
  display: block;
}

.slider-content .home-slider .slide-image .slider-text-info{
  position: absolute;
  bottom: 50%;
  transform: translateY(50%);
  width: 35%;
}
.slider-content .home-slider .slide-image .slider-text-info.slider-text-left{
  left: 10%;
  text-align: left;
}
.slider-content .home-slider .slide-image .slider-text-info.slider-text-center{
  left: 10%;
  right: 10%;
  margin: 0 auto;
  text-align: center;
}
.slider-content .home-slider .slide-image .slider-text-info.slider-text-right{
  right: 10%;
  text-align: right;
}
.slider-content .home-slider .slide-image .slider-text-info span{
  font-size: 20px;
  display: block;
  font-weight: 300;

}
.slider-content .home-slider .slide-image .slider-text-info h1{
  font-size: 50px;
  margin-top: 12px;
  font-weight: 600;
  text-transform: uppercase;
  font-family: 'Fredoka', sans-serif;
}
.slider-content .home-slider .slide-image .slider-text-info p{
  line-height: 25px;
  margin-top: 11px;
  margin-bottom: 0;

}
.slider-content .home-slider .slide-image .slider-text-info a{
  margin-top: 32px;
}
.slider-content .home-slider .active .slide-image .slider-text-info span{
  -webkit-animation-name: fadeInUp;
  animation-name: fadeInUp;
  -webkit-animation-delay: 0.2s;
  animation-delay: 0.2s;
  -webkit-animation-fill-mode: both;
  animation-fill-mode: both;
  -webkit-animation-duration: 0.2s;
  animation-duration: 0.2s;
}
.slider-content .home-slider .active .slide-image .slider-text-info h1{
  -webkit-animation-name: fadeInUp;
  animation-name: fadeInUp;
  -webkit-animation-delay: 0.4s;
  animation-delay: 0.4s;
  -webkit-animation-fill-mode: both;
  animation-fill-mode: both;
  -webkit-animation-duration: 0.4s;
  animation-duration: 0.4s;
}
.slider-content .home-slider .active .slide-image .slider-text-info a{
  -webkit-animation-name: fadeInUp;
  animation-name: fadeInUp;
  -webkit-animation-delay: 0.6s;
  animation-delay: 0.6s;
  -webkit-animation-fill-mode: both;
  animation-fill-mode: both;
  -webkit-animation-duration: 0.6s;
  animation-duration: 0.6s;
}
@media (max-width : 1399px){
  .slider-content .home-slider .slide-image .slider-text-info h1 {
    font-size: 40px;
  }
}
@media (max-width : 1199px){
  .slider-content {
    margin-top: 0;
  }
  .slider-content .home-slider .slide-image .slider-text-info span {
    font-size: 16px;
  }
  .slider-content .home-slider .slide-image .slider-text-info h1{
    font-size: 30px;
  }
  .slider-content .home-slider .slide-image .slider-text-info a{
    margin-top: 25px;
  }
  .slider-content .grid-wrap .grid-wrapper {
    width: calc(100% - 30px);
  }
}
@media (max-width : 767px){
  .slider-content .grid-wrap {
    margin: -15px 0 0 -15px;
  }
  .slider-content .grid-wrap .grid-wrapper {
    width: calc(100% - 15px);
    margin: 30px 0 0 15px;
  }

 .slider-content .home-slider .slide-image .slider-text-info.slider-text-left{
  left: 30px;
}
.slider-content .home-slider .slide-image .slider-text-info.slider-text-center{
  left: 30px;
  right: 30px;
}
.slider-content .home-slider .slide-image .slider-text-info.slider-text-right{
  right: 30px;
}
}
@media (max-width : 479px){
  .slider-content .home-slider .slide-image .slider-text-info {
    width: 50%;
  }
  .slider-content .home-slider .slide-image .slider-text-info span {
    font-size: 14px;
  }
  .slider-content .home-slider .slide-image .slider-text-info h1 {
    font-size: 24px;
  }
}

.slider-content .home-slider .slider-arrow button {
  color: #fff;
  border: 2px solid var(--color-primary);
  background-color: var(--color-primary);
}
.slider-content .home-slider .slider-arrow button {
  position: absolute;
  z-index: 1;
  bottom: 50%;
  border-radius: 3px;
  transform: translateY(50%);
  font-size: 20px;
  height: 30px;
  width: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.slider-content .home-slider .slider-arrow button:hover{
  color: var(--color-primary);
  background-color: transparent;
}
.slider-content .home-slider .slider-arrow button.arrow-next {
  right: 30px;
}
.slider-content .home-slider .slider-arrow button.arrow-prev {
  left: 30px;
}
@media (max-width : 991px){
  .slider-content .home-slider .slider-arrow button.arrow-prev {
    left: 15px;
  }
  .slider-content .home-slider .slider-arrow button.arrow-next {
    right: 15px;
  }
}
@media (max-width : 767px){
  .slider-content .home-slider .slider-arrow {
    display: none;
  }
}

.slider-content .home-slider .slider-dot {
  bottom: 30px;
  left: 0;
  right: 0;
  line-height: 0;
  position: absolute;
  z-index: 1;
  text-align: center;
}
.slider-content .home-slider .slider-dot span {
  width: 6px;
  height: 6px;
  opacity: 1;
  border-radius: 50%;
  background-color: var(--color-primary);
}
.slider-content .home-slider .slider-dot span {
  margin: 0 5px;
}
.slider-content .home-slider .slider-dot span:hover,
.slider-content .home-slider .slider-dot span.swiper-pagination-bullet-active {
  background-color: var(--color-secondary); 
}

</style>
<section class="slider-content">
  <div class="container">
    {%- if request.page_type == 'index' and section.settings.mobile_brand_links_enabled -%}
      {%- capture mobile_brand_links -%}
        {%- for link_index in (1..5) -%}
          {%- liquid
            assign label_key = 'mobile_brand_label_' | append: link_index
            assign url_key = 'mobile_brand_url_' | append: link_index
            assign tone_key = 'mobile_brand_tone_' | append: link_index
            assign link_tone = section.settings[tone_key] | default: 'plain'
            assign link_label = section.settings[label_key]
            assign link_url = section.settings[url_key]
            if link_url == blank
              case link_index
                when 1
                  assign link_url = '/collections/all?sort_by=best-selling'
                when 2
                  assign link_url = '/collections/san-pellegrino-soda-cesitleri'
                when 3
                  assign link_url = '/products/perrier-do-al-mineralli-gazl-su-200-ml-24lu-koli'
                when 4
                  assign link_url = '/collections/san-benedetto-italyan-icecekleri'
                when 5
                  assign link_url = '/collections/flavz-meyve-sulari'
              endcase
            endif
          -%}
          {%- if link_label != blank -%}
            <li><a class="home-mobile-brand-links__link--{{ link_tone | escape }}" href="{{ link_url | escape }}">{{ link_label | escape }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if mobile_brand_links != blank -%}
        <nav class="home-mobile-brand-links" aria-label="Ürünler ve markalar">
          <ul class="home-mobile-brand-links__list" role="list">{{ mobile_brand_links }}</ul>
        </nav>
      {%- endif -%}
    {%- endif -%}
    <div class="grid-wrap{% if section.settings.secondary_image != blank %} has-secondary{% endif %}">
      <div class="grid-wrapper">
        <pg-home-carousel class="home-carousel" data-kind="hero">
        <div class="home-slider swiper" id="home-slider-{{ section.id }}">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
            {%- liquid
              assign desktop_image = block.settings.slider_bg_img | default: block.settings.slider_img
              assign mobile_image = block.settings.slider_img | default: desktop_image
              assign desktop_aspect_ratio = desktop_image.aspect_ratio | default: 1.8
              assign mobile_aspect_ratio = mobile_image.aspect_ratio | default: 3
            -%}
            <div class="swiper-slide slide-{{ block.id }}" data-block-id="{{ block.id }}" {{ block.shopify_attributes }} style="--desktop-image-padding: {{ 100.0 | divided_by: desktop_aspect_ratio }}%; --mobile-image-padding: {{ 100.0 | divided_by: mobile_aspect_ratio }}%;">
              <div class="slide-image">
                {%- assign ga4_slider_promotion_name = block.settings.slider_title | default: block.settings.slider_sub_title | default: block.settings.slider_bg_img.alt | default: 'Ana sayfa slider' -%}
                {%- assign ga4_slider_slot = 'home_hero_slider_' | append: forloop.index -%}
                <a
                  class="ratio"
                  href="{{ block.settings.slider_button_url }}"
                  aria-label="{{ block.settings.slider_button_url }}"
                  data-ga4-promotion-click
                  data-ga4-promotion-id="{{ ga4_slider_slot | escape }}"
                  data-ga4-promotion-name="{{ ga4_slider_promotion_name | escape }}"
                  data-ga4-creative-name="{{ ga4_slider_promotion_name | escape }}"
                  data-ga4-creative-slot="{{ ga4_slider_slot | escape }}"
                  data-ga4-click-area="Ana sayfa slider"
                  data-ga4-source-page-type="home"
                  data-ga4-source-page-name="Ana sayfa"
                >
                  {%- if block.settings.slider_bg_img != blank or block.settings.slider_img != blank -%}
                    {%- assign desktop_image = block.settings.slider_bg_img | default: block.settings.slider_img -%}
                    {%- assign mobile_image = block.settings.slider_img | default: desktop_image -%}
                    <picture>
                      <source media="(max-width: 600px)" srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 550 }} 550w, {{ mobile_image | image_url: width: 900 }} 900w" sizes="calc(100vw - 30px)">
                      <source media="(min-width: 601px)" srcset="{{ desktop_image | image_url: width: 750 }} 750w, {{ desktop_image | image_url: width: 1100 }} 1100w, {{ desktop_image | image_url: width: 1680 }} 1680w, {{ desktop_image | image_url: width: 2000 }} 2000w" sizes="(min-width: 1500px) {% if section.settings.secondary_image != blank %}{{ 1370 | minus: section.settings.desktop_secondary_width | minus: section.settings.desktop_gap }}{% else %}1370{% endif %}px, (min-width: 1400px) {% if section.settings.secondary_image != blank %}{{ 1290 | minus: section.settings.desktop_secondary_width | minus: section.settings.desktop_gap }}{% else %}1290{% endif %}px, (min-width: 1200px) {% if section.settings.secondary_image != blank %}{{ 1150 | minus: section.settings.desktop_secondary_width | minus: section.settings.desktop_gap }}{% else %}1110{% endif %}px, calc(100vw - 30px)">
                      {{ desktop_image | image_url: width: 1680 | image_tag: loading: 'lazy', decoding: 'async', class: 'img-fluid', alt: desktop_image.alt }}
                    </picture>
                  {%- else -%}
                    {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </a>
                <div class="slider-text-info {% if block.settings.slider_content_position == "right" %}slider-text-right{% elsif block.settings.slider_content_position == "center" %}slider-text-center{% else %}slider-text-left{% endif %}">
                  {%if block.settings.slider_sub_title != '' %}
                  <span style="color:{{ block.settings.slider_subtitle_color }};">{{ block.settings.slider_sub_title }}</span>
                  {%endif%}
                  {%if block.settings.slider_title != '' %}
                  <h1 style="color:{{ block.settings.slider_title_color }};">{{ block.settings.slider_title }}</h1>
                  {%endif%}
                  {% if block.settings.slider_button != '' %}
                  <a href="{{ block.settings.slider_button_url }}" class="btn btn-style1">{{ block.settings.slider_button }}</a>
                  {% endif %}
                </div>
              </div>
            </div>
            {% endfor %}
          </div>
          {% if section.settings.dots %}
          <div class="slider-dot"></div>
          {% endif %}
          {% if section.settings.nav %}
          <div class="slider-arrow">
            <button class="arrow-prev" aria-label="Slider arrow"><i class="fa fa-angle-double-left"></i></button>
            <button class="arrow-next" aria-label="Slider arrow"><i class="fa fa-angle-double-right"></i></button>
          </div>
          {% endif %}
        </div>
        <script type="application/json" data-carousel-options>
          {"slidesPerView":1,"spaceBetween":0,"loop":{{ section.settings.loop | json }},"pagination":{{ section.settings.dots | json }},"navigation":{{ section.settings.nav | json }},"autoplay":{% if section.settings.autoplay %}{"delay":{{ section.settings.autoplay_time | default: 5000 }},"disableOnInteraction":false,"pauseOnMouseEnter":true},"speed":{{ section.settings.autoplay_speed | default: 1000 }}{% else %}false{% endif %}}
        </script>
        </pg-home-carousel>
      </div>
      {%- if section.settings.secondary_image != blank -%}
        <div class="secondary-hero">
          <{% if section.settings.secondary_link != blank %}a href="{{ section.settings.secondary_link }}"{% else %}div{% endif %} class="secondary-hero__link"{% if section.settings.secondary_link != blank %} aria-label="{{ section.settings.secondary_alt | default: section.settings.secondary_image.alt | default: 'Kampanyayı incele' | escape }}"{% endif %} data-ga4-promotion-click data-ga4-promotion-id="home_secondary_banner" data-ga4-promotion-name="{{ section.settings.secondary_alt | default: section.settings.secondary_image.alt | default: 'İkinci manşet' | escape }}" data-ga4-creative-slot="home_secondary_banner" data-ga4-click-area="Ana sayfa ikinci manşet" data-ga4-source-page-type="home" data-ga4-source-page-name="Ana sayfa">
            <picture>
              <source media="(min-width: 1200px)" srcset="{{ section.settings.secondary_image | image_url: width: 360 }} 360w, {{ section.settings.secondary_image | image_url: width: 540 }} 540w, {{ section.settings.secondary_image | image_url: width: 720 }} 720w, {{ section.settings.secondary_image | image_url: width: 1000 }} 1000w" sizes="(min-width: 1400px) {{ section.settings.desktop_secondary_width }}px, {{ section.settings.desktop_secondary_width | minus: 40 }}px">
              <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" width="{{ section.settings.secondary_image.width }}" height="{{ section.settings.secondary_image.height }}" alt="{{ section.settings.secondary_alt | default: section.settings.secondary_image.alt | escape }}" loading="lazy" decoding="async">
            </picture>
          </{% if section.settings.secondary_link != blank %}a{% else %}div{% endif %}>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
<!-- Hero Section End -->
